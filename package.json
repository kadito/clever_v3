{
  "name": "clever-dashboard",
  "version": "1.0.0",
  "description": "CLEVER internal dashboard application",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev": "wrangler dev",
    "dev:full": "pnpm dev & pnpm dev:frontend",
    "dev:frontend": "pnpm --filter @clever/frontend dev",
    "dev:backend": "pnpm --filter @clever/backend dev",
    "dev:shared": "pnpm --filter @clever/shared dev",
    "test": "pnpm -r test",
    "lint": "eslint . --ext .ts,.vue",
    "lint:fix": "eslint . --ext .ts,.vue --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --build",
    "type-check:watch": "tsc --build --watch",
    "type-check:shared": "pnpm --filter @clever/shared type-check",
    "type-check:frontend": "pnpm --filter @clever/frontend type-check",
    "type-check:backend": "pnpm --filter @clever/backend type-check",
    "check-all": "pnpm type-check && pnpm lint && pnpm format:check",
    "deploy:test": "VITE_APP_ENV=test pnpm build && wrangler deploy",
    "deploy:prod": "VITE_APP_ENV=production pnpm build && wrangler deploy --env production"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "fast-check": "^4.5.3",
    "js-yaml": "^4.1.1",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.6.1",
    "wrangler": "^3.114.16"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
