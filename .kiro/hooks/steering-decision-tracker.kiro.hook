{
  "enabled": true,
  "name": "Steering Decision Tracker",
  "description": "Monitors when decisions that impact project steering are made and prompts to add them to .kiro steering files",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Review the recent conversation and identify any decisions that impact the steering of the project. If any steering decisions were made, add them to the appropriate .kiro steering files. Steering decisions include: architecture changes, technology choices, design patterns, coding standards, project constraints, or any other decisions that guide how the project should be developed going forward."
  }
}