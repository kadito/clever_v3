{
  "enabled": true,
  "name": "Deps Reminder",
  "description": "Reminds to run pnpm install after editing a package.json.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["**/package.json"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "A package.json was just edited. Remind the user to run `pnpm install` from the repo root to keep dependencies in sync, unless the change was only to scripts or metadata fields that don't affect installed packages."
  }
}
