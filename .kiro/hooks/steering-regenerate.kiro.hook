{
  "enabled": true,
  "name": "Regenerate Steerings",
  "description": "Re-analyzes the repo and updates steering files to reflect current state.",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "askAgent",
    "prompt": "Activate the power \"kiro-spec-methodology\" #project-bootstrap.md The keyword is \"bootproject\". Focus on Step 1 and Step 2 only: review the existing steering files in .kiro/steering/, compare them against the current codebase, and propose updates for any that are stale or missing. Present each file for validation before saving."
  },
  "workspaceFolderName": "clever_kiro",
  "shortName": "steering-regenerate"
}