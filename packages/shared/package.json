{
  "name": "@clever/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for CLEVER dashboard",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build --force",
    "dev": "tsc --build --watch",
    "clean": "rm -rf dist",
    "test": "vitest --run",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "fast-check": "^4.5.3",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
